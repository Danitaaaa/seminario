{
  "name": "study-app",
  "version": "1.0.0",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev": "npm run db:up && electron-vite dev",
    "build": "electron-vite build",
    "start": "npm run db:up && npm run build && electron-vite preview",
    "package": "npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:demo": "docker cp db/demo/borrar_demo.sql app_postgres:/tmp/borrar_demo.sql && docker cp db/demo/datos_demo.sql app_postgres:/tmp/datos_demo.sql && docker exec app_postgres sh -c \"psql -q -v ON_ERROR_STOP=1 -U $POSTGRES_USER -d $POSTGRES_DB -f /tmp/borrar_demo.sql -f /tmp/datos_demo.sql\"",
    "db:demo:borrar": "docker cp db/demo/borrar_demo.sql app_postgres:/tmp/borrar_demo.sql && docker exec app_postgres sh -c \"psql -q -v ON_ERROR_STOP=1 -U $POSTGRES_USER -d $POSTGRES_DB -f /tmp/borrar_demo.sql\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@turbodocx/html-to-docx": "^1.23.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "katex": "^0.16.22",
    "lucide-react": "^1.51.0",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "pg": "^8.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^10.5.0",
    "react-router-dom": "^7.18.4",
    "react-spreadsheet": "^0.10.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.10.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.1",
    "@vladmandic/face-api": "^1.7.15",
    "electron": "^44.6.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.0.4",
    "vitest": "^1.6.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@44.6.0": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "@turbodocx/html-to-docx@1.23.1": true
  }
}
